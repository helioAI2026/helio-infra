# AWS Integration Testing Environment Setup

# AWS Credentials (Required for integration tests)
# Get these from AWS Console → IAM → Users → Your User → Security Credentials
# export AWS_ACCESS_KEY_ID="your_access_key_here"
# export AWS_SECRET_ACCESS_KEY="your_secret_access_key_here"

# AWS Configuration (Optional)
export AWS_REGION="us-east-1"

# S3 Bucket Configuration (Optional - defaults to 'helio-ai-events')
# export S3_BUCKET="your-custom-bucket-name"

# DynamoDB Configuration (Optional - defaults to 'HelioDriveEvents')
# export DYNAMODB_TABLE="your-custom-table-name"

# Testing Configuration (Optional)
# export PYTEST_TIMEOUT="30"
# export PYTHONUNBUFFERED="1"

# To use this file:
# 1. Add your AWS credentials (uncomment and fill in the lines above)
# 2. Run: source aws.env
# 3. Verify: aws sts get-caller-identity
# 4. Run: python setup_aws.py
# 5. Run: pytest tests/test_integration.py -v
# 6. Cleanup: python cleanup_aws.py
